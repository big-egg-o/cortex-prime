{{#if limited}}
<div class="cp-sheet cp-limited">
  <header class="cp-sheet-header">
    <img class="cp-portrait" src="{{ actor.img }}" alt="{{ actor.name }}">
    <div class="cp-sheet-title">
      <h2 class="cp-actor-name">{{ actor.name }}</h2>
    </div>
  </header>
</div>
{{else}}
<div class="cp-sheet{{#if native}} cp-native{{/if}}{{#if play}} cp-play{{/if}}{{#if gmc}} cp-gmc{{/if}}">
  <header class="cp-sheet-header">
    <img class="cp-portrait" src="{{ actor.img }}" alt="{{ actor.name }}" {{#unless play}}data-edit="img" data-action="editImage"
      data-tooltip="{{ localize "CORTEX.Sheet.EditPortrait" }}"{{/unless}}>
    <div class="cp-sheet-title">
      {{#if play}}<h2 class="cp-actor-name">{{ actor.name }}</h2>{{else}}
      <input class="cp-actor-name" type="text" name="name" value="{{ source.name }}"
        placeholder="{{ localize "CORTEX.Sheet.Name" }}" aria-label="{{ localize "CORTEX.Sheet.Name" }}">
      {{/if}}
      {{#if kindPicker}}
      <select class="cp-kind-select" name="system.kindId" aria-label="{{ localize "CORTEX.Sheet.Kind" }}">
        {{#if kindPicker.unassigned}}<option value="">{{ localize "CORTEX.Sheet.ChooseKind" }}</option>{{/if}}
        {{#each kindPicker.options}}<option value="{{ this.value }}" {{#if this.selected}}selected{{/if}}>{{ this.label }}</option>{{/each}}
      </select>
      {{else}}
      {{#if kindName}}<p class="hint cp-kind">{{ kindName }}</p>{{/if}}
      {{/if}}
    </div>
    {{#if pc}}
    <div class="cp-balance">
      <span>{{ localize "CORTEX.Sheet.Design.PlotPoints" }}</span>
      {{#if editMode}}<input name="system.plotPoints" type="number" data-dtype="Number" min="0" step="1"
        value="{{ plotPoints }}" aria-label="{{ localize "CORTEX.Sheet.Design.PlotPoints" }}">
      {{else}}<strong>{{ plotPoints }}</strong>{{/if}}
    </div>
    {{/if}}
    {{#if canEdit}}
    <button type="button" class="{{#unless native}}ui-control icon {{/unless}}cp-edit-toggle{{#if editMode}} active{{/if}}" data-action="toggleEdit"
      aria-pressed="{{#if editMode}}true{{else}}false{{/if}}"
      data-tooltip="{{ localize "CORTEX.Sheet.EditMode" }}" {{#unless native}}aria-label="{{ localize "CORTEX.Sheet.EditMode" }}"{{/unless}}><i class="fa-solid fa-pen-to-square" inert></i>
      {{#if native}}{{#if editMode}}{{localize "CORTEX.Sheet.Design.Done"}}{{else}}{{localize "CORTEX.Sheet.Design.Edit"}}{{/if}}{{/if}}</button>
    {{/if}}
  </header>

  <section class="cp-sheet-body scrollable">
    {{#if notice}}<p class="notification info">{{ notice }}</p>{{/if}}

    {{#if blockChoices.length}}
    <div class="cp-block-tools">
      <select class="cp-block-choice" aria-label="{{ localize "CORTEX.Sheet.Design.Block" }}">
        {{#each blockChoices}}<option value="{{ id }}">{{ name }}</option>{{/each}}
      </select>
      <button type="button" data-action="addBlock">{{ localize "CORTEX.Sheet.Design.AddBlock" }}</button>
    </div>
    {{/if}}
    {{#each sections}}
    <fieldset class="cp-trait-set{{#if this.free}} cp-free-traits{{/if}}{{#if this.shutDown}} cp-shut-down{{/if}}{{#if this.wide}} cp-wide{{/if}}"
      data-block="{{#if this.block}}{{ this.block }}{{else}}{{ this.id }}{{/if}}"
      {{#if this.free}}data-free-traits{{else}}data-set-id="{{ this.id }}"{{/if}}>
      <legend><span class="cp-set-name">{{ this.name }}</span>
        {{#if @root.canBuild}}
        <button type="button" class="ui-control icon" data-action="hideBlock" aria-label="{{ localize "CORTEX.Sheet.Design.HideBlock" }}"
          data-tooltip="{{ localize "CORTEX.Sheet.Design.HideBlock" }}"><i class="fa-solid fa-eye-slash" inert></i></button>
        {{/if}}
        {{#if this.canShutDown}}
        <button type="button" class="{{#unless @root.play}}ui-control icon {{/unless}}cp-set-shutdown cp-shut-down-toggle{{#if this.shutDown}} active{{/if}}"
          data-action="toggleSetShutDown" data-shut-down="{{#if this.shutDown}}true{{else}}false{{/if}}"
          aria-pressed="{{#if this.shutDown}}true{{else}}false{{/if}}"
          data-tooltip="{{ this.shutDownLabel }}"
          aria-label="{{#if @root.play}}{{localize "CORTEX.Sheet.ShutDown.SetToggleLabel" set=this.name}}{{else}}{{this.shutDownLabel}}{{/if}}">
          {{#if @root.play}}<i class="fa-solid {{#if this.shutDown}}fa-rotate-left{{else}}fa-layer-group{{/if}}" inert></i>
          {{localize "CORTEX.Sheet.ShutDown.SetToggle"}}{{else}}<i class="fa-solid fa-power-off" inert></i>{{/if}}
        </button>
        {{/if}}
      </legend>
      {{#if this.shutDown}}<p class="hint cp-shut-down-note">{{ localize "CORTEX.Sheet.ShutDown.Set" }}</p>{{/if}}
      {{#if this.showSetSfx}}
      <div class="cp-set-sfx">
        {{#if this.standaloneSfx}}
        {{> "systems/cortex-prime/templates/actor/sfx-list.hbs" sfx=this.sfx edit=this.sfxEdit removeAction="removeGmcSfx"}}
        {{#if this.sfxEdit}}<button type="button" data-action="addGmcSfx">{{ localize "CORTEX.Sheet.Details.AddSfx" }}</button>{{/if}}
        {{else}}
        <h4>{{ localize "CORTEX.Sheet.Details.SetSfx" }}</h4>
        {{> "systems/cortex-prime/templates/actor/sfx-list.hbs" sfx=this.sfx edit=this.sfxEdit removeAction="removeSetSfx"}}
        {{#if this.sfxEdit}}
        <button type="button" class="cp-add-detail" data-action="addSetSfx" aria-label="{{ this.addSetSfxLabel }}">
          <i class="fa-solid fa-plus" inert></i><span>{{ localize "CORTEX.Sheet.Details.AddSfx" }}</span>
        </button>
        {{/if}}
        {{/if}}
      </div>
      {{/if}}
      {{#if (and this.emptyText (not this.traits.length) (not this.fallback))}}<p class="hint">{{ this.emptyText }}</p>{{/if}}
      {{#*inline "traitRows"}}
      {{#each rows}}
      <div class="form-group cp-trait{{#if this.shutDown}} cp-shut-down{{/if}}"
        {{#if this.entryId}}data-entry-id="{{ this.entryId }}"{{/if}}
        {{#if this.poolTraitId}}data-pool-trait-id="{{ this.poolTraitId }}"{{/if}}>
        {{#if @root.play}}<div class="cp-trait-line">{{/if}}
        {{#if this.nameInput}}
        <label><input type="text" class="cp-trait-name" name="{{ this.nameInput }}" value="{{ this.name }}"
          aria-label="{{ localize "CORTEX.Sheet.TraitName" }}"></label>
        {{else if this.playRoll}}
        <button type="button" class="cp-pick-trait" data-action="addToPool" aria-label="{{ this.poolLabels.add }}">
          <span>{{ this.label }}</span>
          {{#if ../sharedRating}}<i class="fa-solid fa-plus" inert></i>{{else}}<strong>{{ this.ratingText }}</strong>{{/if}}
        </button>
        {{else}}
        <label>{{ this.label }}</label>
        {{/if}}
        <div class="{{#if @root.play}}cp-trait-actions{{else}}form-fields{{/if}}">
          {{#if this.editable}}
            {{#each this.slots}}
            <select name="{{ this.inputName }}" class="cp-die{{#if this.adds}} cp-die-add{{/if}}"
              aria-label="{{ this.ariaLabel }}" data-tooltip="{{ this.ariaLabel }}">
              <option value="">{{#if this.adds}}+{{else}}–{{/if}}</option>
              {{#each this.options}}<option value="{{ this.value }}" {{#if this.selected}}selected{{/if}}>{{ this.label }}</option>{{/each}}
            </select>
            {{/each}}
            {{#unless this.dice.length}}<span class="cp-rating-note">{{ this.ratingText }}</span>{{/unless}}
          {{else}}
            {{#if this.newSlot}}
            <select name="{{ this.newSlot.inputName }}" class="cp-die cp-die-add"
              aria-label="{{ this.newSlot.ariaLabel }}" data-tooltip="{{ this.newSlot.ariaLabel }}">
              <option value="">+</option>
              {{#each this.newSlot.options}}<option value="{{ this.value }}">{{ this.label }}</option>{{/each}}
            </select>
            {{/if}}
            {{#unless this.playRoll}}<span class="cp-rating-note">{{ this.ratingText }}</span>{{/unless}}
          {{/if}}
          {{#if (and this.rollable (or (not this.playRoll) this.canHinder this.canChallenge))}}
          <span class="cp-pool-buttons">
            {{#unless this.playRoll}}
            <button type="button" class="ui-control icon" data-action="addToPool"
              data-tooltip="{{ this.poolLabels.add }}" aria-label="{{ this.poolLabels.add }}"><i class="fa-solid fa-dice" inert></i></button>
            {{/unless}}
            {{#if this.canHinder}}
            <button type="button" class="{{#unless @root.native}}ui-control icon{{/unless}}" data-action="addToPool" data-option="hinder"
              data-tooltip="{{ this.poolLabels.hinder }}" aria-label="{{ this.poolLabels.hinder }}">{{#if @root.native}}{{localize "CORTEX.Builder.Option.hinder"}}{{else}}<i class="fa-solid fa-arrow-down-wide-short" inert></i>{{/if}}</button>
            {{/if}}
            {{#if this.canChallenge}}
            <button type="button" class="{{#unless @root.native}}ui-control icon{{/unless}}" data-action="addToPool" data-option="challenge"
              data-tooltip="{{ this.poolLabels.challenge }}" aria-label="{{ this.poolLabels.challenge }}">{{#if @root.native}}{{localize "CORTEX.Builder.Option.challenge"}}{{else}}<i class="fa-solid fa-bolt" inert></i>{{/if}}</button>
            {{/if}}
            {{#if this.canHinderChallenge}}
            <button type="button" class="{{#unless @root.native}}ui-control icon{{/unless}}" data-action="addToPool" data-option="hinderChallenge"
              data-tooltip="{{ this.poolLabels.hinderChallenge }}" aria-label="{{ this.poolLabels.hinderChallenge }}">{{#if @root.native}}{{localize "CORTEX.Builder.Option.hinderChallenge"}}{{else}}<i class="fa-solid fa-angles-down" inert></i>{{/if}}</button>
            {{/if}}
          </span>
          {{/if}}
          {{#if this.canShutDown}}
          <button type="button" class="ui-control icon cp-shut-down-toggle{{#if this.ownShutDown}} active{{/if}}"
            data-action="toggleShutDown" data-shut-down="{{#if this.ownShutDown}}true{{else}}false{{/if}}"
            aria-pressed="{{#if this.ownShutDown}}true{{else}}false{{/if}}"
            data-tooltip="{{ this.shutDownLabel }}"
            aria-label="{{#if @root.play}}{{localize "CORTEX.Sheet.ShutDown.SetTrait" trait=this.label}}{{else}}{{this.shutDownLabel}}{{/if}}">
            <i class="fa-solid {{#if (and @root.play this.ownShutDown)}}fa-rotate-left{{else}}fa-power-off{{/if}}" inert></i>
          </button>
          {{/if}}
          {{#if (and ../canLoseDice @root.play @root.canEdit)}}
          {{#each this.dice}}
          <button type="button" class="cp-lose-die" data-action="loseDie" data-index="{{ @index }}" data-size="{{ this }}"
            aria-label="{{ localize "CORTEX.Sheet.Design.LoseDie" size=this }}">{{ localize "CORTEX.Sheet.Design.LoseDie" size=this }}</button>
          {{/each}}
          {{/if}}
          {{#if (and this.nameInput (not ../threat))}}
          <button type="button" class="ui-control icon cp-remove-trait" data-action="removeTrait"
            data-tooltip="{{ this.removeLabel }}" aria-label="{{ this.removeLabel }}"><i class="fa-solid fa-trash" inert></i></button>
          {{/if}}
        </div>
        {{#if @root.play}}</div>{{/if}}
        {{#if this.descriptionInput}}
        <input type="text" class="cp-description-input" name="{{ this.descriptionInput }}" value="{{ this.description }}"
          placeholder="{{ localize "CORTEX.Sheet.Details.Description" }}" aria-label="{{ this.descriptionLabel }}">
        {{else if this.description}}
        {{#if @root.play}}
        <details class="cp-reference"><summary>{{ localize "CORTEX.Sheet.Details.Description" }}</summary>
          <p class="cp-description">{{ this.description }}</p></details>
        {{else}}<p class="cp-description">{{ this.description }}</p>{{/if}}
        {{/if}}
        {{#if this.statementInput}}
        <input type="text" class="cp-statement-input" name="{{ this.statementInput }}" value="{{ this.statement }}"
          placeholder="{{ localize "CORTEX.Sheet.Statement.Placeholder" }}" aria-label="{{ this.statementLabel }}">
        {{else if this.statement}}
        <p class="cp-statement">{{ this.statement }}</p>
        {{/if}}
        {{#if this.challenged}}
        <div class="cp-challenged">
          <span class="cp-challenged-badge"><i class="fa-solid fa-bolt" inert></i> {{ localize "CORTEX.Sheet.Statement.Challenged" }}</span>
          {{#if this.canResolve}}
          <button type="button" data-action="resolveChallenge" data-rewritten="true"
            data-tooltip="{{ this.resolveLabels.rewritten }}" aria-label="{{ this.resolveLabels.rewritten }}">{{ localize "CORTEX.Sheet.Statement.RewrittenButton" }}</button>
          <button type="button" data-action="resolveChallenge" data-rewritten="false"
            data-tooltip="{{ this.resolveLabels.kept }}" aria-label="{{ this.resolveLabels.kept }}">{{ localize "CORTEX.Sheet.Statement.KeptButton" }}</button>
          {{/if}}
        </div>
        {{/if}}
        {{#if this.tagsInput}}
        <string-tags class="cp-tags-input" name="{{ this.tagsInput }}" value="{{ this.tagsValue }}"
          aria-label="{{ this.tagsLabel }}"></string-tags>
        {{else if this.tags.length}}
        <ul class="cp-tags">{{#each this.tags}}<li>{{ this }}</li>{{/each}}</ul>
        {{/if}}
        {{#if (or this.sfx.length this.sfxEdit)}}
        <div class="cp-trait-sfx">
          {{> "systems/cortex-prime/templates/actor/sfx-list.hbs" sfx=this.sfx edit=this.sfxEdit removeAction="removeSfx"}}
          {{#if this.sfxEdit}}
          <button type="button" class="cp-add-detail" data-action="addSfx" aria-label="{{ this.addSfxLabel }}">
            <i class="fa-solid fa-plus" inert></i><span>{{ localize "CORTEX.Sheet.Details.AddSfx" }}</span>
          </button>
          {{/if}}
        </div>
        {{/if}}
        {{#if (or this.subTraits.length this.subEdit)}}
        <div class="cp-sub-traits">
          {{#each this.subTraits}}
          <div class="cp-sub-trait" {{#if this.id}}data-sub-id="{{ this.id }}"{{/if}}>
            {{#if (and ../subEdit this.nameInput)}}
            <input type="text" class="cp-sub-name" name="{{ this.nameInput }}" value="{{ this.name }}" aria-label="{{ this.nameLabel }}">
            {{#each this.slots}}
            <select name="{{ this.inputName }}" class="cp-die{{#if this.adds}} cp-die-add{{/if}}"
              aria-label="{{ this.ariaLabel }}" data-tooltip="{{ this.ariaLabel }}">
              <option value="">{{#if this.adds}}+{{else}}–{{/if}}</option>
              {{#each this.options}}<option value="{{ this.value }}" {{#if this.selected}}selected{{/if}}>{{ this.label }}</option>{{/each}}
            </select>
            {{/each}}
            <button type="button" class="ui-control icon" data-action="removeSubTrait"
              data-tooltip="{{ this.removeLabel }}" aria-label="{{ this.removeLabel }}"><i class="fa-solid fa-trash" inert></i></button>
            {{else}}
            <span class="cp-sub-name">{{ this.label }}</span>
            <span class="cp-rating-note">{{ this.ratingText }}</span>
            {{/if}}
          </div>
          {{/each}}
          {{#if this.subEdit}}
          <button type="button" class="cp-add-detail" data-action="addSubTrait" aria-label="{{ this.addSubLabel }}">
            <i class="fa-solid fa-plus" inert></i><span>{{ localize "CORTEX.Sheet.Details.AddSub" }}</span>
          </button>
          {{/if}}
        </div>
        {{/if}}
        {{#if this.shutDownText}}<p class="hint cp-shut-down-note">{{ this.shutDownText }}</p>{{/if}}
        {{#each this.hintTexts}}<p class="hint">{{ this }}</p>{{/each}}
      </div>
      {{/each}}
      {{/inline}}
      {{> traitRows rows=this.traits}}
      {{#if this.fallback}}
      <details class="cp-fallback-traits" data-sync="fallback-{{ this.id }}">
        <summary>{{ localize "CORTEX.Sheet.Design.OtherFallbackTraits" set=this.name die=this.fallback.die }}</summary>
        <div class="cp-fallback-choices">
          {{> traitRows rows=this.fallback.traits sharedRating=true}}
        </div>
      </details>
      {{/if}}
      {{#if @root.editMode}}{{#if this.open}}
      <button type="button" class="cp-add-trait" data-action="addTrait">
        <i class="fa-solid fa-plus" inert></i><span>{{ localize "CORTEX.Sheet.AddTrait" }}</span>
      </button>
      {{/if}}{{/if}}
    </fieldset>
    {{/each}}

    {{#if others}}
    <fieldset class="cp-other-traits">
      <legend>{{ localize "CORTEX.Sheet.Others.Title" }}</legend>
      <p class="hint">{{ localize "CORTEX.Sheet.Others.Hint" }}</p>
      {{#each others.groups}}
      <div class="cp-other-group" {{#if this.free}}data-free-traits{{else}}data-set-id="{{ this.setId }}"{{/if}}>
        <h4>{{ this.label }}</h4>
        {{#each this.traits}}
        <div class="form-group cp-trait" {{#if this.entryId}}data-entry-id="{{ this.entryId }}"{{/if}}
          data-trait-name="{{ this.label }}">
          <label>{{ this.label }}</label>
          <div class="form-fields">
            <span class="cp-rating-note">{{ this.ratingText }}</span>
            {{#if this.entryId}}
            <button type="button" class="ui-control icon cp-remove-trait" data-action="removeTrait"
              data-tooltip="{{ this.removeLabel }}" aria-label="{{ this.removeLabel }}"><i class="fa-solid fa-trash" inert></i></button>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </div>
      {{/each}}
    </fieldset>
    {{/if}}
  </section>
</div>
{{/if}}
