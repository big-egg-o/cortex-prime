<section class="cp-trait-tracker">
  {{#if invalid}}
  <p class="notification error">{{ localize "CORTEX.Assets.Invalid" }} ({{ invalid }})</p>
  {{else}}
  <div class="cp-tracker-actions">
    <button type="button" data-action="addComplication"><i class="fa-solid fa-triangle-exclamation" inert></i> {{ localize "CORTEX.Assets.AddComplication" }}</button>
    <button type="button" data-action="addAsset"><i class="fa-solid fa-plus" inert></i> {{ localize "CORTEX.Assets.AddAsset" }}</button>
  </div>
  <div class="cp-tracker-groups">
    {{#each sections}}
    <h4 class="cp-tracker-heading">{{ this.title }}</h4>
    <ul class="cp-tracker-list">
      {{#each this.traits}}
      <li class="cp-tracker-trait{{#if this.complication}} cp-complication{{/if}}" data-trait-id="{{ this.id }}">
        <div class="cp-tracker-line">
          <strong class="cp-tracker-die">{{ this.die }}</strong>
          <span class="cp-tracker-name">{{ this.name }}</span>
          <span class="cp-tracker-meta">{{ this.kind }} · {{ this.origin }}{{#each this.badges}} · {{ this }}{{/each}}</span>
          <button type="button" class="icon fa-solid fa-minus" data-action="stepDown" data-trait-id="{{ this.id }}" data-tooltip="{{ localize "CORTEX.Assets.StepDown" }}" aria-label="{{ localize "CORTEX.Assets.StepDown" }}"></button>
          <button type="button" class="icon fa-solid fa-plus" data-action="stepUp" data-trait-id="{{ this.id }}" data-tooltip="{{ localize "CORTEX.Assets.StepUp" }}" aria-label="{{ localize "CORTEX.Assets.StepUp" }}"></button>
          <button type="button" class="icon fa-solid fa-user-tag" data-action="assign" data-trait-id="{{ this.id }}" data-tooltip="{{ localize "CORTEX.Assets.Assign" }}" aria-label="{{ localize "CORTEX.Assets.Assign" }}"></button>
          <button type="button" class="icon fa-solid fa-note-sticky" data-action="editNote" data-trait-id="{{ this.id }}" data-tooltip="{{ localize "CORTEX.Assets.Note" }}" aria-label="{{ localize "CORTEX.Assets.Note" }}"></button>
          <button type="button" class="icon fa-solid fa-trash" data-action="remove" data-trait-id="{{ this.id }}" data-tooltip="{{ localize "CORTEX.Assets.Remove" }}" aria-label="{{ localize "CORTEX.Assets.Remove" }}"></button>
        </div>
        {{#if this.note}}<p class="cp-tracker-note">{{ this.note }}</p>{{/if}}
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="hint">{{ localize "CORTEX.Assets.Empty" }}</p>
    {{/each}}
  </div>
  <div class="cp-tracker-end">
    <button type="button" data-action="endScene"><i class="fa-solid fa-flag-checkered" inert></i> {{ localize "CORTEX.Assets.EndScene" }}</button>
    <button type="button" data-action="endSession"><i class="fa-solid fa-moon" inert></i> {{ localize "CORTEX.Assets.EndSession" }}</button>
  </div>
  {{/if}}
</section>
