<div class="cortex-prime contest-card">
  <h4 class="cp-contest-title">
    <span>{{ title }}</span>
    {{#if highStakes}}<span class="cp-contest-badge cp-high-stakes">{{ localize "CORTEX.Contest.Card.HighStakes" }}</span>{{/if}}
  </h4>

  <ul class="cp-contest-sides">
    {{#each sides}}
    <li data-side="{{ this.key }}" class="{{#if this.expected}}cp-expected{{/if}} {{#if this.winner}}cp-winner{{/if}}">
      <span class="cp-side-role">{{ this.role }}</span>
      <span class="cp-side-label">{{ this.label }}</span>
    </li>
    {{/each}}
  </ul>

  {{#if difficulty}}
  <div class="cp-contest-difficulty">
    <p>
      {{ localize "CORTEX.Contest.Card.Difficulty" }} <strong>{{ difficulty.total }}</strong>
      {{#if difficulty.level}}<span class="cp-contest-level">({{ difficulty.level.label }})</span>{{/if}}
    </p>
    <p class="cp-contest-origin">
      {{#if difficulty.messageId}}
      <a data-action="show-roll" data-roll-id="{{ difficulty.messageId }}">{{ localize (concat "CORTEX.Contest.Card.DifficultyOrigin." difficulty.origin) }}</a>
      {{else}}
      {{ localize (concat "CORTEX.Contest.Card.DifficultyOrigin." difficulty.origin) }}
      {{/if}}
    </p>
    {{#if difficulty.effects.length}}
    <p class="cp-contest-opposition">
      {{ localize "CORTEX.Contest.Card.OppositionEffects" }}
      {{#each difficulty.effects}}<span class="cp-die">d{{ this.size }}</span>{{/each}}
    </p>
    {{/if}}
    {{#if difficulty.takeOut}}
    <p class="cp-contest-take-out">{{ localize "CORTEX.Contest.Card.OppositionTakeOut" }}</p>
    {{/if}}
  </div>
  {{/if}}

  {{#if rolls.length}}
  <ol class="cp-contest-rolls">
    {{#each rolls}}
    <li data-side="{{ this.side }}" class="{{#if this.standing}}cp-standing{{/if}}">
      <span class="cp-roll-side">{{ this.label }}</span>
      <strong class="cp-roll-total">{{ this.total }}</strong>
      <span class="cp-roll-effects">
        {{#each this.effects}}<span class="cp-die {{#if this.overflowOpen}}cp-overflow-open{{/if}}"
          {{#if this.overflowOpen}}data-tooltip="CORTEX.Contest.Card.OverflowOpen"{{/if}}>d{{ this.size }}{{#if this.overflowOpen}}+{{/if}}</span>{{/each}}
      </span>
      <span class="cp-roll-origin">
        {{#if this.messageId}}
        <a data-action="show-roll" data-roll-id="{{ this.messageId }}">{{ localize (concat "CORTEX.Contest.Card.RollOrigin." this.origin) }}</a>
        {{else}}
        {{ localize (concat "CORTEX.Contest.Card.RollOrigin." this.origin) }}
        {{/if}}
      </span>
    </li>
    {{/each}}
  </ol>
  {{/if}}

  {{#unless isTest}}
  {{#if (eq status.key "waiting")}}
  {{#if toBeat includeZero=true}}
  <p class="cp-contest-to-beat">{{ localize "CORTEX.Contest.Card.ToBeat" }} <strong>{{ toBeat }}</strong></p>
  {{/if}}
  {{/if}}
  {{/unless}}

  <p class="cp-contest-status" data-status="{{ status.key }}">{{ status.label }}</p>

  {{#if outcome}}
  <div class="cp-contest-outcome">
    {{#if isTest}}
    <p class="cp-outcome-line">
      {{#if outcome.success}}
      <strong>{{ localize "CORTEX.Contest.Card.Success" }}</strong>
      {{else}}
      <strong>{{ localize "CORTEX.Contest.Card.Failure" }}</strong>
      {{/if}}
      <span>{{ localize "CORTEX.Contest.Card.Margin" margin=outcome.margin }}</span>
    </p>
    {{else}}
    <p class="cp-outcome-line">
      <strong>{{ localize (concat "CORTEX.Contest.Card.Ending." outcome.ending) side=outcome.label }}</strong>
      {{#if outcome.margin includeZero=true}}<span>{{ localize "CORTEX.Contest.Card.Margin" margin=outcome.margin }}</span>{{/if}}
    </p>
    {{/if}}
    {{#if outcome.heroicSteps}}
    <p><span class="cp-contest-badge cp-heroic">{{ localize "CORTEX.Contest.Card.Heroic" steps=outcome.heroicSteps }}</span></p>
    {{/if}}
    {{#if closedEarly}}
    <p class="cp-contest-pending">{{ localize "CORTEX.Contest.Card.End.ClosedEarly" }}</p>
    {{else}}
    {{#if outcome.pending}}{{#unless end.heroic}}{{#unless end.overflows.length}}
    <p class="cp-contest-pending">{{ localize (concat "CORTEX.Contest.Card.Pending." outcome.pending) }}</p>
    {{/unless}}{{/unless}}{{/if}}
    {{/if}}
  </div>
  {{/if}}

  {{#if end.heroic}}
  <div class="cp-contest-end cp-end-heroic">
    <p>{{ localize "CORTEX.Contest.Card.End.Heroic" steps=end.heroic.steps }}</p>
    <div class="cp-controls">
      {{#each end.heroic.dice}}
      <button type="button" data-action="apply-heroic-steps" data-effect-id="{{ this.effectId }}">
        <span class="cp-die">d{{ this.size }}</span>
      </button>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{#each end.overflows}}
  <div class="cp-contest-end cp-end-overflow" data-effect-id="{{ this.effectId }}">
    <p>{{ localize "CORTEX.Contest.Card.End.Overflow" }}</p>
    <div class="cp-controls">
      {{#each this.leftovers}}
      <button type="button" data-action="choose-overflow" data-effect-id="{{ ../effectId }}" data-kind="leftover" data-die-id="{{ this.dieId }}">
        <span>{{ localize "CORTEX.Contest.Card.End.Leftover" size=this.size }}</span>
      </button>
      {{/each}}
      <button type="button" data-action="choose-overflow" data-effect-id="{{ this.effectId }}" data-kind="new-d6">
        <span>{{ localize "CORTEX.Contest.Card.End.NewDie" size=this.newDie }}</span>
      </button>
      {{#if this.takeOut}}
      <button type="button" data-action="choose-overflow" data-effect-id="{{ this.effectId }}" data-kind="take-out">
        <span>{{ localize "CORTEX.Contest.Card.End.TakeOut" }}</span>
      </button>
      {{/if}}
    </div>
  </div>
  {{/each}}

  {{#if end.pick}}
  <div class="cp-contest-end cp-end-pick">
    <p>{{ localize "CORTEX.Contest.Card.End.Pick" }}</p>
    <div class="cp-pick-dice">
      {{#each end.pick.dice}}
      <label><input type="checkbox" data-effect-id="{{ this.effectId }}" {{#if this.checked}}checked{{/if}}><span class="cp-die">d{{ this.size }}</span></label>
      {{/each}}
    </div>
    <div class="cp-controls">
      <button type="button" data-action="use-against-loser">
        <span>{{ localize "CORTEX.Contest.Card.End.Use" }}</span>
      </button>
    </div>
  </div>
  {{/if}}

  {{#if result}}
  <div class="cp-contest-result">
    {{#if result.effects.length}}
    <p>
      {{ localize "CORTEX.Contest.Card.Result.Effects" }}
      {{#each result.effects}}<span class="cp-die">d{{ this.size }}</span>{{/each}}
    </p>
    {{/if}}
    {{#if result.takeOut}}
    <p class="cp-contest-take-out">{{ localize "CORTEX.Contest.Card.Result.TakeOut" }}</p>
    {{/if}}
  </div>
  {{/if}}

  {{#if consequence}}
  <div class="cp-contest-consequence" data-ending="{{ consequence.ending }}">
    <p class="cp-consequence-title">
      <strong>{{ localize "CORTEX.Contest.Card.Consequence.Title" }}</strong>
      {{#if consequence.preview}}<span class="cp-contest-badge">{{ localize "CORTEX.Contest.Card.Consequence.Preview" }}</span>{{/if}}
    </p>
    {{#if consequence.preview}}
    <p class="cp-contest-origin">{{ localize "CORTEX.Contest.Card.Consequence.PreviewHint" }}</p>
    {{/if}}

    {{#if (eq consequence.ending "won")}}
    {{#if consequence.takenOut}}
    <p class="cp-contest-take-out"><strong>{{ localize "CORTEX.Contest.Card.Consequence.TakenOut" side=consequence.loserLabel }}</strong></p>
    <p>
      {{ localize "CORTEX.Contest.Card.Consequence.AvoidWithPP" }}
      {{#each consequence.avoidWithPP}}<span class="cp-die">d{{ this.size }}</span>{{/each}}
    </p>
    {{/if}}
    {{#if consequence.comparisons.length}}
    <ul class="cp-consequence-lines">
      {{#each consequence.comparisons}}
      <li data-effect-id="{{ this.effectId }}">
        <span class="cp-die">d{{ this.winnerDie }}</span>
        {{#if this.loserDie}}{{ localize "CORTEX.Contest.Card.Consequence.Against" size=this.loserDie }}{{else}}{{ localize "CORTEX.Contest.Card.Consequence.AgainstNone" }}{{/if}}
        {{#if this.takesOut}}
        {{ localize "CORTEX.Contest.Card.Consequence.TakesOut" }}
        {{else if this.complication}}
        {{#if this.steppedDown}}{{ localize "CORTEX.Contest.Card.Consequence.SteppedDown" size=this.complication }}{{else}}{{ localize "CORTEX.Contest.Card.Consequence.Complication" size=this.complication }}{{/if}}
        {{else}}
        {{ localize "CORTEX.Contest.Card.Consequence.SteppedAway" }}
        {{/if}}
      </li>
      {{/each}}
    </ul>
    {{else}}
    {{#unless consequence.takenOut}}<p>{{ localize "CORTEX.Contest.Card.Consequence.NoDice" }}</p>{{/unless}}
    {{/if}}
    {{/if}}

    {{#if (eq consequence.ending "gaveIn")}}
    <p>{{ localize "CORTEX.Contest.Card.Consequence.GaveIn" }}</p>
    {{#if consequence.ppEligible}}<p>{{ localize "CORTEX.Contest.Card.Consequence.MayEarnPP" side=consequence.loserLabel }}</p>{{/if}}
    {{#if consequence.rematchBlocked}}<p>{{ localize "CORTEX.Contest.Card.Consequence.RematchBlocked" side=consequence.loserLabel }}</p>{{/if}}
    {{/if}}

    {{#if (eq consequence.ending "declined")}}
    {{#if consequence.unrolled}}
    <p>{{ localize "CORTEX.Contest.Card.Consequence.Unrolled" }}</p>
    {{else}}
    <p>
      {{ localize "CORTEX.Contest.Card.Consequence.WinnerEffects" }}
      {{#each consequence.winnerEffects}}<span class="cp-die">d{{ this.size }}</span>{{/each}}
    </p>
    {{/if}}
    {{/if}}
  </div>
  {{/if}}

  <div class="cp-controls">
    {{#if button}}
    <button type="button" data-action="roll-for-contest" data-side="{{ button.side }}" data-roll-index="{{ button.rollIndex }}">
      <i class="fa-solid fa-dice" inert></i><span>{{ button.label }}</span>
    </button>
    {{/if}}
    {{#if controls.total}}
    <button type="button" data-action="enter-total" data-side="{{ controls.total.side }}">
      <i class="fa-solid fa-keyboard" inert></i><span>{{ localize "CORTEX.Contest.Card.EnterTotal" }}</span>
    </button>
    {{/if}}
    {{#if controls.giveIn}}
    <button type="button" data-action="give-in" data-side="{{ controls.giveIn.side }}" data-request="{{ controls.giveIn.action }}">
      <i class="fa-solid fa-flag" inert></i><span>{{ controls.giveIn.label }}</span>
    </button>
    {{/if}}
    {{#if controls.highStakes}}
    <button type="button" data-action="toggle-high-stakes" data-value="{{ controls.highStakes.value }}">
      <i class="fa-solid fa-triangle-exclamation" inert></i>
      <span>{{#if controls.highStakes.value}}{{ localize "CORTEX.Contest.Card.HighStakesOff" }}{{else}}{{ localize "CORTEX.Contest.Card.HighStakesOn" }}{{/if}}</span>
    </button>
    {{/if}}
    {{#if controls.close}}
    <button type="button" data-action="close-contest">
      <i class="fa-solid fa-lock" inert></i><span>{{ localize "CORTEX.Contest.Card.Close" }}</span>
    </button>
    {{/if}}
  </div>
</div>
