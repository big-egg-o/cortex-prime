<div class="cortex-prime poolroll-card">
  <header class="headline{{#if botch}} botch{{/if}}">{{ headline }}</header>

  <ul class="dice-row">
    {{#each dice}}
    <li class="die role-{{ this.role }}{{#if this.clickable}} clickable{{/if}}" data-die-id="{{ this.id }}"
      {{#if this.clickable}}data-action="cycle-die"{{/if}}
      title="{{ this.roleLabel }}" aria-label="{{ this.roleLabel }}: {{ this.label }} d{{ this.size }} {{ this.result }}">
      <span class="die-shape d{{ this.size }}">{{ this.result }}</span>
      <span class="die-label">{{ this.label }}</span>
    </li>
    {{/each}}
  </ul>

  {{#if interactive}}
  <div class="pool-selection">
    {{#if selection.errors.length}}
    <ul class="errors">
      {{#each selection.errors}}
      <li class="error">{{ this.message }}</li>
      {{/each}}
    </ul>
    {{/if}}

    {{#unless botch}}
    <div class="shortcuts">
      <button type="button" data-action="two-highest">{{ localize "CORTEX.Chat.TwoHighest" }}</button>
      <button type="button" data-action="biggest-effect">{{ localize "CORTEX.Chat.BiggestEffect" }}</button>
    </div>
    {{/unless}}

    <div class="counters">
      <div class="counter" data-counter="extra-results">
        <span class="counter-label">{{ localize "CORTEX.Chat.ExtraResultsPaid" }}</span>
        <button type="button" data-action="decrement-extra-results">-</button>
        <span class="counter-value">{{ selection.extraResultsPaid }}</span>
        <button type="button" data-action="increment-extra-results">+</button>
      </div>
      <div class="counter" data-counter="extra-effect-dice">
        <span class="counter-label">{{ localize "CORTEX.Chat.ExtraEffectDicePaid" }}</span>
        <button type="button" data-action="decrement-extra-effect-dice">-</button>
        <span class="counter-value">{{ selection.extraEffectDicePaid }}</span>
        <button type="button" data-action="increment-extra-effect-dice">+</button>
      </div>
    </div>

    <button type="button" class="confirm" data-action="confirm" {{#unless selection.valid}}disabled{{/unless}}>
      {{ localize "CORTEX.Chat.Confirm" }}
    </button>
  </div>
  {{/if}}
</div>
