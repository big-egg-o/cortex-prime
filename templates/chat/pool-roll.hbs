<div class="cortex-prime poolroll-card">
  <header class="headline{{#if botch}} botch{{/if}}">{{ headline }}</header>

  <ul class="dice-row">
    {{#each dice}}
    <li class="die role-{{ this.role }}{{#if this.clickable}} clickable{{/if}}{{#if this.marked}} marked-for-reroll{{/if}}"
      data-die-id="{{ this.id }}" {{#if this.clickable}}data-action="{{ this.action }}"{{/if}}
      title="{{ this.roleLabel }}" aria-label="{{ this.roleLabel }}: {{ this.label }} d{{ this.size }} {{ this.result }}">
      <span class="die-shape d{{ this.size }}"><span class="die-result">{{ this.result }}</span></span>
      <span class="die-label">{{ this.label }}</span>
    </li>
    {{/each}}
  </ul>

  {{#if interactive}}
  {{#unless reroll.active}}
  <div class="pool-selection">
    {{#if selection.errors.length}}
    <ul class="errors">
      {{#each selection.errors}}
      <li class="error">{{ this.message }}</li>
      {{/each}}
    </ul>
    {{/if}}

    {{#unless botch}}
    <div class="shortcuts">
      <button type="button" data-action="two-highest">{{ localize "CORTEX.Chat.TwoHighest" }}</button>
      <button type="button" data-action="biggest-effect">{{ localize "CORTEX.Chat.BiggestEffect" }}</button>
    </div>
    {{/unless}}

    <div class="counters">
      <div class="counter" data-counter="extra-results">
        <span class="counter-label">{{ localize "CORTEX.Chat.ExtraResultsPaid" }}</span>
        <button type="button" data-action="decrement-extra-results">-</button>
        <span class="counter-value">{{ selection.extraResultsPaid }}</span>
        <button type="button" data-action="increment-extra-results">+</button>
      </div>
      <div class="counter" data-counter="extra-effect-dice">
        <span class="counter-label">{{ localize "CORTEX.Chat.ExtraEffectDicePaid" }}</span>
        <button type="button" data-action="decrement-extra-effect-dice">-</button>
        <span class="counter-value">{{ selection.extraEffectDicePaid }}</span>
        <button type="button" data-action="increment-extra-effect-dice">+</button>
      </div>
    </div>

    <button type="button" class="confirm" data-action="confirm" {{#unless selection.valid}}disabled{{/unless}}>
      {{ localize "CORTEX.Chat.Confirm" }}
    </button>
  </div>
  {{/unless}}
  {{/if}}

  {{#if effectControls}}
  <div class="effect-controls">
    {{#each effectControls}}
    <div class="effect-control" data-effect-index="{{ this.index }}">
      <span class="effect-size">d{{ this.size }}</span>
      {{#if this.canStepDown}}
      <button type="button" class="icon-button step-down" data-action="step-effect-die"
        data-effect-index="{{ this.index }}" data-steps="-1"
        title="{{ localize "CORTEX.Chat.StepDown" }}" aria-label="{{ localize "CORTEX.Chat.StepDown" }}"></button>
      {{/if}}
      <button type="button" class="icon-button step-up" data-action="step-effect-die"
        data-effect-index="{{ this.index }}" data-steps="1"
        title="{{ localize "CORTEX.Chat.StepUp" }}" aria-label="{{ localize "CORTEX.Chat.StepUp" }}"></button>
    </div>
    {{/each}}
  </div>
  {{/if}}

  {{#if overflowChoice}}
  <div class="overflow-choice">
    {{#each overflowChoice.leftovers}}
    <button type="button" data-action="overflow-choice" data-kind="leftover" data-die-id="{{ this.dieId }}">
      {{ this.label }}
    </button>
    {{/each}}
    <button type="button" data-action="overflow-choice" data-kind="new-d6">{{ overflowChoice.newDieLabel }}</button>
    {{#if overflowChoice.takeOutAvailable}}
    <button type="button" data-action="overflow-choice" data-kind="take-out">{{ overflowChoice.takeOutLabel }}</button>
    {{/if}}
  </div>
  {{/if}}

  {{#if reroll}}
  <div class="reroll-controls">
    <button type="button" class="{{#if reroll.active}}active{{/if}}" data-action="toggle-reroll-mode">
      {{#if reroll.active}}{{ localize "CORTEX.Chat.CancelReroll" }}{{else}}{{ localize "CORTEX.Chat.Reroll" }}{{/if}}
    </button>
    {{#if reroll.active}}
    <button type="button" data-action="reroll" {{#unless reroll.canReroll}}disabled{{/unless}}>
      {{ localize "CORTEX.Chat.RerollMarked" }}
    </button>
    {{/if}}
  </div>
  {{/if}}
</div>
