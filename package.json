{
  "name": "cortex-prime",
  "version": "0.0.0",
  "private": true,
  "description": "Cortex Prime game system for Foundry VTT V14 (development tooling only; nothing here ships).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test",
    "foundry": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-foundry.ps1",
    "quench": "node scripts/run-quench.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "vitest": "^5.0.3"
  }
}
